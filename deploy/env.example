# /etc/vuln-watch/env (root, mode 600), loaded as a systemd EnvironmentFile.
# Do not quote values.

# discord.mode = "dm"
DISCORD_BOT_TOKEN=
# Overrides discord.user_id
DISCORD_USER_ID=

# discord.mode = "webhook"
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...

# Recommended. A fine-grained token with no permissions is enough.
GITHUB_TOKEN=

# Optional. Pinged after every successful run.
# HEARTBEAT_URL=https://hc-ping.com/...

RUST_LOG=info
