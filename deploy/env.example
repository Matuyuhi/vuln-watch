# /etc/vuln-watch/env  (chmod 600, root 所有)
# systemd の EnvironmentFile として読み込まれる。値をクォートしないこと。

# discord.mode = "dm" のとき: Bot のトークン
DISCORD_BOT_TOKEN=
# DM の送り先（config.toml の discord.user_id より優先）
DISCORD_USER_ID=

# discord.mode = "webhook" のとき
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxx/yyy

# 推奨: 権限なしの fine-grained token で OK（公開データの読み取りのみ）
#  - GitHub Advisory API のレート制限を 60/h → 5000/h に
#  - CVE List を CDN キャッシュを通さず API から取得（最大5分速くなる）
GITHUB_TOKEN=

# 任意: 死活監視（healthchecks.io 等）
# HEARTBEAT_URL=https://hc-ping.com/xxxxxxxx

# ログレベル（trace / debug / info / warn）
RUST_LOG=info
