# vuln-watch@run.service    : poll feeds and send urgent notifications
# vuln-watch@digest.service : send the queued digest
[Unit]
Description=vuln-watch (%i)
Documentation=https://github.com/Matuyuhi/vuln-watch
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/bin/vuln-watch --config /etc/vuln-watch/config.toml %i
EnvironmentFile=/etc/vuln-watch/env
TimeoutStartSec=300

# State (SQLite) lives in /var/lib/vuln-watch; $STATE_DIRECTORY is passed to the binary.
DynamicUser=yes
StateDirectory=vuln-watch
StateDirectoryMode=0700

# Hardening: the process only needs outbound HTTPS and its state directory.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged
CapabilityBoundingSet=
UMask=0077
MemoryMax=256M
